{
  "name": "mycelium-mvp",
  "version": "0.1.0",
  "description": "Federated AI agent orchestration system simulating the AT Protocol",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsx --no-warnings src/demo/run.ts --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.protocol.json",
    "lexicon:check": "tsx --no-warnings scripts/check-lexicons.ts",
    "lexicon:generate": "tsx --no-warnings scripts/generate-lexicons.ts",
    "demo": "tsx --no-warnings src/demo/run.ts",
    "dashboard": "tsx --no-warnings src/demo/dashboard/server.ts",
    "reset": "tsx --no-warnings scripts/reset.ts",
    "query": "tsx --no-warnings scripts/query.ts",
    "pds-init": "tsx --no-warnings scripts/pds-init.ts"
  },
  "dependencies": {
    "@atproto/crypto": "^0.5.5",
    "@atproto/lex-cbor": "^0.1.6",
    "@atproto/repo": "^0.10.14",
    "@duckdb/node-api": "^1.5.0-r.1",
    "@noble/ed25519": "^2.0.0",
    "@noble/hashes": "^1.3.3",
    "bs58": "^6.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "fastify": "^4.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@atproto/lex-cli": "^0.10.13",
    "@atproto/xrpc": "^0.8.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "multiformats": "^14.0.5",
    "tsx": "^4.7.1",
    "typescript": "^7.0.2",
    "vitest": "^1.3.1",
    "ws": "^8.20.0"
  }
}
