{
  "lexicon": 1,
  "id": "me.lqdev.mycelium.authority.revocation",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["delegationUri", "revokerDid", "reason", "createdAt"],
        "properties": {
          "delegationUri": { "type": "ref", "ref": "me.lqdev.mycelium.common#atUri" },
          "revokerDid": { "type": "ref", "ref": "me.lqdev.mycelium.common#did" },
          "reason": { "type": "string", "maxLength": 10000 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
