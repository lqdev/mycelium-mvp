{
  "lexicon": 1,
  "id": "me.lqdev.mycelium.task.acceptance",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["taskUri", "completionUri", "requesterDid", "outcome", "createdAt"],
        "properties": {
          "taskUri": { "type": "ref", "ref": "me.lqdev.mycelium.common#atUri" },
          "completionUri": { "type": "ref", "ref": "me.lqdev.mycelium.common#atUri" },
          "requesterDid": { "type": "ref", "ref": "me.lqdev.mycelium.common#did" },
          "outcome": { "type": "string", "knownValues": ["accepted", "rejected", "partial"] },
          "notes": { "type": "string", "maxLength": 10000 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
