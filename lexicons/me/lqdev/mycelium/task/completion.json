{
  "lexicon": 1,
  "id": "me.lqdev.mycelium.task.completion",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["taskUri", "claimUri", "workerDid", "summary", "artifactUris", "createdAt"],
        "properties": {
          "taskUri": { "type": "ref", "ref": "me.lqdev.mycelium.common#atUri" },
          "claimUri": { "type": "ref", "ref": "me.lqdev.mycelium.common#atUri" },
          "workerDid": { "type": "ref", "ref": "me.lqdev.mycelium.common#did" },
          "summary": { "type": "string", "maxLength": 10000 },
          "artifactUris": { "type": "array", "items": { "type": "ref", "ref": "me.lqdev.mycelium.common#atUri" }, "maxLength": 128 },
          "metrics": { "type": "unknown" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
